{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "main.py"
    }
  ],
  "env": {
    "OPENAI_MODEL": "gpt-4o-mini",
    "ENABLE_YOLO": "false",
    "DEBUG": "false"
  }
}
