{
  "version": 2,
  "functions": {
    "backend/app/main.py": {
      "runtime": "python3.9",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/$1"
    }
  ],
  "env": {
    "OPENAI_API_KEY": "@openai_api_key",
    "OPENAI_MODEL": "gpt-4o-mini",
    "VITE_API_BASE_URL": "@api_base_url",
    "FIREBASE_STORAGE_BUCKET": "@firebase_storage_bucket",
    "ENABLE_YOLO": "false",
    "DEBUG": "false"
  }
}
