{
  "version": 2,
  "builds": [
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python",
      "config": {
        "python": "3.11",
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/app/main.py"
    }
  ],
  "env": {
    "OPENAI_MODEL": "gpt-4o-mini",
    "ENABLE_YOLO": "false",
    "DEBUG": "false",
    "PYTHON_VERSION": "3.11"
  }
}
